# xiaorui_live 前端环境(重启持久, 须 export; 全注释=纯本地默认)
# export XR_BACKEND=hybrid        # 默认 local(板上全本地); hybrid=云优先/本地兜底
# export XR_CLOUD_ASR=1           # 整句 16k Opus 上行，服务端识别；默认0保持本地ASR文本路径
# export XR_LOCAL_ASR=rknn        # 默认；off 仅允许配合 XR_BACKEND=cloud XR_CLOUD_ASR=1
# export XR_KWS_DIR=/data/rknn-test/sherpa/model-kws  # 仅 KWS 资产目录，可平台化部署
# export XR_SHERPA_LIB=libsherpa-onnx-c-api.so       # 必须兼容当前 C ABI
# 关闭本地 ASR 后不初始化离线模型/CLI，KWS 交服务端复核，播放期本地语音控制不可用。
# export XR_CLOUD_URL=ws://127.0.0.1:8001/xiaorui/v1/   # 云端网关(板上 8001)
# export XR_LOCAL_PORT=8002       # 本地网关端口(backend_local 默认即 8002)
# export XR_MIC=asr_mic           # 采集 ALSA 设备, 默认 asr_mic(USB 卡映射)
# export XR_CLOUD_TOKEN=
# export XR_DEVICE_ID=xiaorui-board
# export XR_KWS_THRESHOLD=0.15
# --- 现场调参(2026-10-13 收编进 runtime_config, 改完重启前端生效; 越界自动回默认) ---
# export XR_VAD_PREROLL=5          # 预滚帧数(100ms/帧, 0..30) -- 指令开头被截则调大
# export XR_VAD_TRIGGER_DB=6       # 能量门触发余量(1..20dB) -- 误触发多则调大
# export XR_VAD_SUSTAIN_DB=2       # 持续余量(0..10dB) -- 句中被切碎则调大
# export XR_FOLLOW_WINDOW_S=30     # 跟说窗秒数(5..300)
# export XR_ACK_COOL_MS=1500       # 纯唤醒 ack 后余音冷却
# export XR_FINISH_COOL_MS=1200    # 应答排干后冷却
# export XR_ABANDON_COOL_MS=800    # 判空弃轮后冷却
# export XR_ECHO_GUARD_S=4         # 回声护栏窗(0..30s, 0=关) -- 应答后尾音被当指令则调大
# export XR_ECHO_MIN_CMD_CHARS=3   # 只抑制低于此字数的已知余音词，不按长度拒绝其他短指令
export XR_MUSIC_CONTROLS=1   # 音乐播放中语音控制(实测全绿转正 2026-10-15)

# --- Home Assistant 设备控制(haIntent; 2026-10-19) ---
# export XR_HA_URL=http://127.0.0.1:8123     # 默认即板上本机
# export XR_HA_TOKEN=                        # 默认回退读 /data/xiaorui-server/ha_token.txt
