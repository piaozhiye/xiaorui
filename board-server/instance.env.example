# Source by start-gateway-instance.sh. No secrets in this profile.
# 8002: change instance directories to 8002 and HTTP port to 8005.
# Its private config still selects local RKLLM/ASR/TTS and websocket port 8002.
XR_RELEASE_ID=architecture-candidate
XR_CODE_DIR=/data/xiaorui-gateway/releases/architecture-candidate/server
XR_WORK_DIR=/data/xiaorui-gateway/instances/8001/work
XR_DATA_DIR=/data/xiaorui-gateway/instances/8001/data
XR_CONFIG_FILE=$XR_DATA_DIR/.config.yaml
XR_STATE_DIR=/data/xiaorui-gateway/state
XR_HTTP_PORT=8003
PYTHONPATH=$XR_CODE_DIR
