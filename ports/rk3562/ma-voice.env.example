# Copy to /data/xiaorui-gateway/data/ma-voice.env on the board and chmod 600.
# For an MA Server running on this board, use http://127.0.0.1:8095.
# During PC-hosted integration testing, set the PC MA URL instead.
XR_MA_CONTROL=1
XR_MA_URL=http://127.0.0.1:8095
XR_MA_PLAYER_NAME=rk3562-buildroot
# Create a Music Assistant access token and keep it only in this board-side file.
XR_MA_ACCESS_TOKEN=replace-with-ma-access-token
# Optional when several Snapcast players are visible to MA.
# XR_MA_PLAYER_ID=
# Optional source restriction, e.g. qqmusic or netease.
# XR_MA_PROVIDER_DOMAIN=
