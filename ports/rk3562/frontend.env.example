# RK3562 EVB2 板端前端环境变量（source 后再跑 xiaorui_live）
#
# 平台特性（与 rk3308 / rk3576 都不通用）：
#   - RK809 codec 的 hw 只支持 2ch、8k~96k；前端要 1ch/16k 采集、
#     1ch/24k 播放 -> 由 /etc/asound.conf 的 plug 链做降混/重采样。
#   - deploy-vqe.sh 提供 xr_vqe_16k，处理 PDM 6mic + RK809 回采。
#   - 前端识别走板内网关，LLM 由板内 NPU 上的 RKLLM 提供。

export XR_BACKEND=cloud
export XR_CLOUD_ASR=1
export XR_LOCAL_ASR=off

# 网关地址:
#   板内网关形态(目标): 网关跑在板子自己身上(/data/xiaorui-gateway), 前端连 127.0.0.1:8001
#   板外 PC 网关形态(备选): PC 上跑 ports/pc-gateway/start.sh, 板子经
#     `adb reverse tcp:8101 tcp:8101` 走 USB 隧道连 ws://127.0.0.1:8101/xiaorui/v1/
export XR_CLOUD_URL=ws://127.0.0.1:8001/xiaorui/v1/
export XR_DEVICE_ID=xiaorui-rk3562

# 采集/播放设备名（asound.conf 里定义的 plug 链）
export XR_MIC=xr_vqe_16k
# VQE 插件只认原生 period(256 = 16ms); 前端默认 1600(100ms) 会被拒(EINVAL)
export XR_MIC_PERIOD=256
export XR_SPK=xr_spk

# 唤醒源: 默认瑞芯微 rkaudio_vqe 内置唤醒(读 /tmp/rkaudio_vqe_status 的
# wakeup 边沿, 和 AEC/降噪同一条链路, 不占额外 CPU)。
# 状态文件拿不到时前端自动退回 sherpa KWS; 想强制回退: XR_WAKE_SOURCE=sherpa
# export XR_WAKE_SOURCE=vqe

# 麦克风软件数字增益(线性倍数): PDM 麦 + 6mic 波束后电平偏低(实测唤醒词到板
# 只有 -33dBFS), 板载 809 的 MIC Boost 管不到 PDM 通路, VQE 里也没有独立数字
# 增益口 -> 在软件里补一级。1.0=关, 2.0=+6dB, 4.0=+12dB。削顶会按样本计数上报。
# export XR_MIC_GAIN=2.0

# KWS：板端 sherpa-onnx C API + 本仓 KWS 模型（keywords.txt 是仓根的小瑞词表）
export XR_KWS_DIR=/data/xiaorui/assets/kws
export XR_SHERPA_LIB=/data/xiaorui/lib/libsherpa-onnx-c-api.so

# 动态库：libsherpa-onnx-c-api.so 依赖同目录的 libonnxruntime.so
# 注意用 ${LD_LIBRARY_PATH:-}: 启动脚本带 set -u, 未定义变量会直接退出
export LD_LIBRARY_PATH=/data/xiaorui/lib:${LD_LIBRARY_PATH:-}

# 音量状态文件（前端默认路径就是它）
export XR_VOLUME_FILE=/data/xiaorui-server/xiaorui_volume
export XR_UI_SOCKET=/run/xiaorui/frontend.sock

# 播放期语音控制需要本地 ASR，本板没有 -> 关掉
export XR_MUSIC_CONTROLS=0

# 慢响应填充音("嗯") —— 关掉。
#   默认 700ms: 提交后 0.7s 没等到音频就补一声"嗯"。
#   3562 这块板更慢, 填充音几乎每轮都响, 而且它从板载喇叭漏回麦克风
#   -> VAD 又被触发 -> 新的轮次 -> 再补一声"嗯", 变成"嗯 嗯 嗯"一直不停。
#   板内网关(8001)首包 1s 上下就到, 填充音没有意义, 直接关(见 runtime_config.c)。
export XR_THINK_CUE_MS=0

# 3562 板内网关比 3576 慢(A53@1GHz): 板端 TTS 冷加载 ~15s、合成 RTF~1.1,
# 默认 8s 的"受理后等首包"窗会把慢网关误判成空回答 -> 放宽
export XR_ACCEPTED_SILENCE_S=90
export XR_RESPONSE_TIMEOUT_S=120

# VAD 触发门限: 相对环境底噪的 dB 余量。默认 6dB 实测噪声空轮次 ~1 次/分钟
# (HVAC/风扇低频抖动过门限 -> 提交 -> ASR 转写噪声 -> 静默回执, 浪费推理+日志);
# 10dB 实测 25 分钟零空轮次, 语音(PC 重放活动 -43dBFS)余量 22dB 无损伤,
# ha-ab.sh 回归 5/5(2026-11-12 定案)。
export XR_VAD_TRIGGER_DB=10
