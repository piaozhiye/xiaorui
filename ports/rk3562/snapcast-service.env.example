# Copy to /data/xiaorui/snapcast/service.env and adjust the role/address.
# server-client is the 4 GB A board; client is the 2 GB B board.
XR_SNAPCAST_ROLE=server-client
# Set to auto on a client board to discover the unique _xiaorui-music._tcp
# master on the local LAN. Set XR_SNAPCAST_SERVER_ID when several rooms exist.
XR_SNAPCAST_SERVER_HOST=192.0.2.10
# XR_SNAPCAST_SERVER_ID=abcdef
XR_SNAPCAST_SERVER_BIND=192.0.2.10
XR_SNAPCAST_SERVER_PORT=1704
# Music UI stays loopback-only by default. For phone access, install a TLS
# certificate trusted by the phone and configure allowed hosts plus exactly one
# authentication method: a random password OR one-time browser pairing.
# XR_MUSIC_UI_BIND=0.0.0.0
# XR_MUSIC_UI_TLS_CERT=/data/xiaorui/snapcast/tls/music-ui.crt
# XR_MUSIC_UI_TLS_KEY=/data/xiaorui/snapcast/tls/music-ui.key
# XR_MUSIC_UI_PASSWORD_FILE=/data/xiaorui/snapcast/music-ui.password
# XR_MUSIC_UI_PAIRING_STATE=/data/xiaorui/snapcast/music-state/pairing.json
# XR_MUSIC_UI_PUBLIC_URL=https://xiaorui-music.local:8765
# XR_MUSIC_MDNS_ALIAS=xiaorui-music.local
# XR_MUSIC_UI_ALLOWED_HOSTS=xiaorui-speaker.local,192.0.2.10
XR_SNAPCLIENT_BIN=/data/xiaorui/snapcast/snapclient
XR_SNAPSERVER_BIN=/data/xiaorui/snapcast/server-v0.35.0/snapserver
XR_SNAPCAST_PYTHON=/data/gwvenv/bin/python
XR_SNAPCAST_BRIDGE=/data/xiaorui/snapcast/snapcast-fifo-product.py
XR_SNAPCAST_RAW_FIFO=/data/xiaorui/snapcast/music.raw
XR_MUSIC_FIFO=/data/xiaorui/snapcast/music.fifo
XR_SNAPSERVER_CONFIG=/data/xiaorui/snapcast/server.conf
