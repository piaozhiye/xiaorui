#!/bin/sh
set -eu

directory="${XR_UI_DIRECTORY:-/data/xiaorui-ui}"
runtime="${XDG_RUNTIME_DIR:-/run}"
display="${WAYLAND_DISPLAY:-wayland-0}"
lock="${XR_UI_LOCK_FILE:-/run/xiaorui-ui.lock}"
case "$display" in
    /*) wayland_socket="$display" ;;
    *) wayland_socket="$runtime/$display" ;;
esac

exec 9>"$lock"
if ! flock -n 9; then
    echo 'xiaorui-ui: another service operation is running' >&2
    exit 1
fi

running_pids() {
    for candidate in $(pgrep -x xiaorui_ui || :); do
        executable="$(readlink "/proc/$candidate/exe" 2>/dev/null || :)"
        # 二进制被覆盖后 exe 会带 " (deleted)", 不去掉就认不出这个进程,
         # 老进程会留下来和新进程抢同一块屏幕
        executable="${executable% (deleted)}"
        if [ "$executable" = "$directory/xiaorui_ui" ]; then
            echo "$candidate"
        fi
    done
}

# OOM 优先级: 语音主链路(网关/RKLLM)由 start-ha.sh 保护(-500), UI 只是显示层,
# 内存紧张时先牺牲它, 保住语音链路。进程重启后 pid 变, 所以每次启动重设。
set_oom_priority() {
    for candidate in $(running_pids); do
        echo 200 > "/proc/$candidate/oom_score_adj" 2>/dev/null || true
    done
}

start_ui() {
    if [ -n "$(running_pids)" ]; then
        echo 'xiaorui-ui: already running'
        return 0
    fi
    # /data 上的执行位重启即丢(2026-11-19/2026-11-20 实测三次, S98 门禁
    # 因此从 -x 改成 -f)。这里同样只判"文件在", 不判执行位 ——
    # 实际启动走的是 `sh run.sh` + exec 二进制, 不依赖执行位。
    if [ ! -f "$directory/xiaorui_ui" ] || [ ! -r "$directory/run.sh" ]; then
        echo 'xiaorui-ui: executable or launcher missing' >&2
        return 1
    fi
    attempts=0
    while [ ! -S "$wayland_socket" ]; do
        if [ "$attempts" -ge 20 ]; then
            echo "xiaorui-ui: Wayland unavailable: $wayland_socket" >&2
            return 1
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    # 每次启动轮转上一轮的日志(2026-11-20 用户建议): 不轮转的话旧日志
    # 一直追加, 排查时分不清哪几行属于本次启动。留一份 .1, 再启动覆盖。
    if [ -f "$directory/ui.log" ]; then
        mv "$directory/ui.log" "$directory/ui.log.1" 2>/dev/null || true
    fi
    (setsid env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="$display" \
        XR_UI_DUMP="${XR_UI_DUMP:-/tmp/xiaorui-ui.ppm}" \
        sh "$directory/run.sh" 9>&- >>"$directory/ui.log" 2>&1 </dev/null &)
    attempts=0
    while [ "$attempts" -lt 20 ]; do
        if [ -n "$(running_pids)" ]; then
            # ★ 2026-11-20 review: 光看到进程存在就报"started"是不够 ——
            #   UI 可能起来 100ms 后自己退出(尺寸不符那类失败正是如此),
            #   结果是"语音好好的、屏是黑的", 而 init 脚本还报成功。
            #   所以起来之后再等一小会儿复查, 死了就如实报失败。
            sleep 2
            if [ -n "$(running_pids)" ]; then
                echo 'xiaorui-ui: started'
                set_oom_priority
                return 0
            fi
            echo 'xiaorui-ui: 启动后立刻退出, 见 '"$directory"'/ui.log' >&2
            return 1
        fi
        attempts=$((attempts + 1))
        sleep 0.1
    done
    echo "xiaorui-ui: failed to start; see $directory/ui.log" >&2
    return 1
}

stop_ui() {
    for candidate in $(running_pids); do
        kill -TERM "$candidate"
    done
    attempts=0
    while [ -n "$(running_pids)" ]; do
        if [ "$attempts" -ge 5 ]; then
            echo 'xiaorui-ui: graceful shutdown timed out' >&2
            return 1
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    echo 'xiaorui-ui: stopped'
}

case "${1:-}" in
    start) start_ui ;;
    stop) stop_ui ;;
    # stop 超时(5s)不该把 restart 整个吃掉: 停不掉就硬停, 再起新的。
    restart)
        stop_ui || {
            echo 'xiaorui-ui: 停止超时, 强制结束残留进程' >&2
            for candidate in $(running_pids); do kill -KILL "$candidate" 2>/dev/null || true; done
            sleep 1
        }
        start_ui
        ;;
    status)
        if [ -n "$(running_pids)" ]; then
            echo 'xiaorui-ui: running'
        else
            echo 'xiaorui-ui: stopped'
            exit 1
        fi
        ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
