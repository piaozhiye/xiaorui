# RK3562 + ES8388 (AIOT DEMO LP4X V10) 板端前端环境变量(source 后再跑 xiaorui_live)
#
# 与 ports/rk3562(RK809 + PDM 6mic + rkaudio_vqe) 的差异:
#   - 这块板是 **ES8388 模拟 codec**, 板载麦 + 板载喇叭, 没有 PDM 阵列,
#     没有 RK809 播放回采, 因此没有 AEC ref, 也就用不上 rkaudio_vqe。
#   - 采集走前端内置 ES8388 直采链: 48k/2ch -> 72 阶 FIR 抗混叠 ÷3 -> 16k/mono。
#   - 播放走 xr_spk (plug: 48k/2ch) -> 板载喇叭。
#   - 必须设 XR_MIC_MODE=es8388 + XR_ES8388_CHANNELS=2, 避免 ALSA plug
#     用无抗混叠线性重采样(实际会损害 KWS/ASR)。
#   - 不要设 XR_MIC_PERIOD / xr_vqe_16k: 本板没有 VQE 插件。

# 识别交给板内网关(网关在本机 127.0.0.1:8001), 前端不做本地转写
export XR_BACKEND=cloud
export XR_CLOUD_ASR=1
export XR_LOCAL_ASR=off

# 板内网关地址
export XR_CLOUD_URL=ws://127.0.0.1:8001/xiaorui/v1/
export XR_DEVICE_ID=xiaorui-rk3562-es8388

# 采集/播放设备名(asound-novqe.conf 里的 plug 链, 按卡名 rockchipes8388 寻址)
export XR_MIC=hw:rockchipes8388,0
export XR_MIC_MODE=es8388
export XR_ES8388_CHANNELS=2
export XR_ES8388_MIC_CH=0
export XR_SPK=xr_spk

# KWS 阈值: 非 VQE 直采用 0.15(VQE 版的 0.10 只适用于 bf/agc 抬升后的电平)
export XR_KWS_THRESHOLD=0.15

# KWS: 板端 sherpa-onnx C API + 本仓 KWS 模型
export XR_KWS_DIR=/data/xiaorui/assets/kws
export XR_SHERPA_LIB=/data/xiaorui/lib/libsherpa-onnx-c-api.so

# 动态库: libsherpa-onnx-c-api.so 依赖同目录的 libonnxruntime.so
export LD_LIBRARY_PATH=/data/xiaorui/lib:${LD_LIBRARY_PATH:-}

# 音量状态文件(前端默认路径)
export XR_VOLUME_FILE=/data/xiaorui-server/xiaorui_volume
export XR_UI_SOCKET=/run/xiaorui/frontend.sock

# 播放期语音控制需要本地 ASR, 本板没有 -> 关掉
export XR_MUSIC_CONTROLS=0

# 慢响应填充音("嗯") —— 关掉: 板载喇叭漏回麦克风会再次触发 VAD, 形成"嗯嗯嗯"循环
export XR_THINK_CUE_MS=0

# 板内网关比 PC 慢(A53): 放宽"受理后等首包"窗
export XR_ACCEPTED_SILENCE_S=20
export XR_RESPONSE_TIMEOUT_S=40

# VAD 触发门限: 相对环境底噪的 dB 余量(直采底噪比 USB 麦高)
export XR_VAD_TRIGGER_DB=10
