# Replace placeholders; this is not a ready-to-run board configuration.
export XR_BACKEND=cloud
export XR_CLOUD_ASR=1
export XR_LOCAL_ASR=off
export XR_CLOUD_URL=ws://GATEWAY_LAN_IP:8001/xiaorui/v1/
export XR_DEVICE_ID=xiaorui-rk3308
# Supply authentication privately; never commit tokens.
# export XR_CLOUD_TOKEN=...
# --- RK3308 平台必填(2026-10-21 实测, 见 docs/VALIDATION-RK3308-20261021.md §4) ---
# 采集设备名: RK3308 的 VQE 插件暴露 rkaudio_vqe_16k(原生 16k), 不是 3576 的
# xr_vqe_16k(48k→16k plug)。现场用的是关 AGC 的候选副本 xr_vqe_16k_ng
# (定义在 /root/.asoundrc, 参数与系统设备一致, 只把 config_file 指向 AGC 关的 json 副本)
# —— 系统设备带 AGC, 绝对电平高 18dB 但持续门会失效(见验收记录 §4)。
export XR_MIC=rkaudio_vqe_16k
# 采集周期: RK3308 插件原生 16k/period 256, 只接受 256;
# 强行改成 1600 能开, 但采集与播放会互相 EBUSY(实测)。3576 保持默认 1600。
export XR_MIC_PERIOD=256
# 持续门: 房间底噪中位 -53.5dB, 默认 +2 的门落在噪声分布内部 -> 每句撞 12.1s 上限;
# 抬到 +6 后自然收尾 1.2~2.4s。触发门保持默认 +6。
export XR_VAD_SUSTAIN_DB=6
export XR_KWS_DIR=/data/xiaorui/assets/kws
export XR_SHERPA_LIB=/usr/lib/libsherpa-onnx-c-api.so
export XR_MUSIC_CONTROLS=0
