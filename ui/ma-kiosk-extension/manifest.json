{
  "manifest_version": 3,
  "name": "XiaoRui Music Kiosk Return",
  "version": "1.0.0",
  "description": "Adds a touch target to return from Music Assistant to XiaoRui.",
  "permissions": ["tabs"],
  "host_permissions": ["__XR_MA_ORIGIN__/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["__XR_MA_ORIGIN__/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
